{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 0,
  "modules-left": [
    "custom/workspace#1",
    "custom/workspace#2",
    "custom/workspace#3",
    "custom/workspace#4",
    "custom/workspace#5",
    "custom/workspace#6",
    "custom/workspace#7",
    "custom/workspace#8",
    "custom/workspace#9",
    "custom/workspace#10",
    "hyprland/window"
  ],
  "modules-center": [
    "custom/ticker"
  ],
  "modules-right": [
    "custom/pomodoro",
    "custom/idle-inhibit",
    "cpu",
    "battery",
    "backlight",
    "memory",
    "network",
    "pulseaudio",
    "clock",
    "custom/power"
  ],

  // Waybar 0.15's native Hyprland workspace click uses legacy dispatch syntax.
  "custom/workspace#1": {
    "exec": "~/.config/waybar/scripts/workspace_button.sh status 1",
    "return-type": "json",
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/workspace_button.sh activate 1",
    "on-scroll-up": "~/.config/waybar/scripts/workspace_button.sh previous",
    "on-scroll-down": "~/.config/waybar/scripts/workspace_button.sh next",
    "tooltip": false
  },
  "custom/workspace#2": {
    "exec": "~/.config/waybar/scripts/workspace_button.sh status 2",
    "return-type": "json",
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/workspace_button.sh activate 2",
    "on-scroll-up": "~/.config/waybar/scripts/workspace_button.sh previous",
    "on-scroll-down": "~/.config/waybar/scripts/workspace_button.sh next",
    "tooltip": false
  },
  "custom/workspace#3": {
    "exec": "~/.config/waybar/scripts/workspace_button.sh status 3",
    "return-type": "json",
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/workspace_button.sh activate 3",
    "on-scroll-up": "~/.config/waybar/scripts/workspace_button.sh previous",
    "on-scroll-down": "~/.config/waybar/scripts/workspace_button.sh next",
    "tooltip": false
  },
  "custom/workspace#4": {
    "exec": "~/.config/waybar/scripts/workspace_button.sh status 4",
    "return-type": "json",
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/workspace_button.sh activate 4",
    "on-scroll-up": "~/.config/waybar/scripts/workspace_button.sh previous",
    "on-scroll-down": "~/.config/waybar/scripts/workspace_button.sh next",
    "tooltip": false
  },
  "custom/workspace#5": {
    "exec": "~/.config/waybar/scripts/workspace_button.sh status 5",
    "return-type": "json",
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/workspace_button.sh activate 5",
    "on-scroll-up": "~/.config/waybar/scripts/workspace_button.sh previous",
    "on-scroll-down": "~/.config/waybar/scripts/workspace_button.sh next",
    "tooltip": false
  },
  "custom/workspace#6": {
    "exec": "~/.config/waybar/scripts/workspace_button.sh status 6",
    "return-type": "json",
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/workspace_button.sh activate 6",
    "on-scroll-up": "~/.config/waybar/scripts/workspace_button.sh previous",
    "on-scroll-down": "~/.config/waybar/scripts/workspace_button.sh next",
    "tooltip": false
  },
  "custom/workspace#7": {
    "exec": "~/.config/waybar/scripts/workspace_button.sh status 7",
    "return-type": "json",
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/workspace_button.sh activate 7",
    "on-scroll-up": "~/.config/waybar/scripts/workspace_button.sh previous",
    "on-scroll-down": "~/.config/waybar/scripts/workspace_button.sh next",
    "tooltip": false
  },
  "custom/workspace#8": {
    "exec": "~/.config/waybar/scripts/workspace_button.sh status 8",
    "return-type": "json",
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/workspace_button.sh activate 8",
    "on-scroll-up": "~/.config/waybar/scripts/workspace_button.sh previous",
    "on-scroll-down": "~/.config/waybar/scripts/workspace_button.sh next",
    "tooltip": false
  },
  "custom/workspace#9": {
    "exec": "~/.config/waybar/scripts/workspace_button.sh status 9",
    "return-type": "json",
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/workspace_button.sh activate 9",
    "on-scroll-up": "~/.config/waybar/scripts/workspace_button.sh previous",
    "on-scroll-down": "~/.config/waybar/scripts/workspace_button.sh next",
    "tooltip": false
  },
  "custom/workspace#10": {
    "exec": "~/.config/waybar/scripts/workspace_button.sh status 10",
    "return-type": "json",
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/workspace_button.sh activate 10",
    "on-scroll-up": "~/.config/waybar/scripts/workspace_button.sh previous",
    "on-scroll-down": "~/.config/waybar/scripts/workspace_button.sh next",
    "tooltip": false
  },

  "hyprland/window": {
    "format": "// {title}",
    "max-length": 40
  },

  "cpu": {
    "format": "CPU {usage}%",
    "interval": 3
  },

  "battery": {
    "format": "BAT {capacity}%",
    "format-charging": "CHR {capacity}%",
    "format-plugged": "AC {capacity}%",
    "format-full": "BAT 100%",
    "interval": 30
  },

  "backlight": {
    "format": "BRT {percent}%",
    "on-click": "echo t >> /tmp/qs-brightness-popup"
  },

  "memory": {
    "format": "MEM {percentage}%",
    "interval": 3
  },

  "network": {
    "format-wifi": "NET {essid}",
    "format-ethernet": "ETH {ifname}",
    "format-disconnected": "NET --",
    "tooltip-format": "{ipaddr}"
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "VOL --",
    "on-click": "echo t >> /tmp/qs-volume-popup",
    "on-click-right": "pavucontrol"
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%Y/%m/%d}",
    "tooltip-format": "{:%A %d %B %Y}"
  },

  "custom/ticker": {
    "exec": "echo '接続中 // SCANNING // データ処理 // SYS:ACTIVE // NR-2B@ARCH // 全システム正常 // 起動完了 //'",
    "interval": 60,
    "format": "{}"
  },

  "custom/pomodoro": {
    "exec": "~/.config/waybar/scripts/pomodoro.sh",
    "interval": 1,
    "format": "{}",
    "on-click": "~/.config/waybar/scripts/pomodoro_toggle.sh"
  },

  "custom/idle-inhibit": {
    "exec": "~/.config/waybar/scripts/idle_inhibit.sh status",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/idle_inhibit.sh toggle"
  },

  "custom/power": {
    "format": "⏻",
    "on-click": "hyprctl dispatch exit"
  }
}
