# Unit-3 Berserk — fish terminal colors
#
# fish's default autosuggestion color is "brblack", which maps to kitty
# color8 (#1D1913) — almost identical to the background (#14100B), so
# suggestions become invisible. Use a brighter warm ash-gray that still
# reads as a dim hint behind real input.
set -g fish_color_autosuggestion A49C89