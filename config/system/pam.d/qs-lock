# PAM configuration for Quickshell lockscreen
# Installed by Unit-3 installer
#
# Adding pam_gnome_keyring (mirroring system-local-login) makes the Units-3
# lockscreen password also unlock the GNOME login keyring — needed since
# greetd autologin no longer performs a password auth at boot.
auth      include   system-auth
auth      optional  pam_gnome_keyring.so
account   include   system-auth
password  include   system-auth
session   include   system-auth
session   optional  pam_gnome_keyring.so auto_start